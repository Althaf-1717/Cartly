# ==============================================================================
# CARTLY - ENVIRONMENT CONFIGURATION (LOCAL & VERCEL)
# ==============================================================================

# Application URL (Use http://localhost:3000 locally or your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL & Realtime Configuration
# Obtain from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Payments (Simulated sandbox enabled if omitted)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Cloudinary CDN (Supabase Storage is primary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
